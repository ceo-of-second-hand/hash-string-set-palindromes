{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build lab (debug)",
            "type": "shell",
            "command": "if (!(Test-Path build)) { mkdir build | Out-Null }; & 'C:/Program Files/CodeBlocks/MinGW/bin/g++.exe' -g -O0 -std=c++17 -Wall -Wextra -static main.cpp -o build/lab_debug.exe",
            "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run tests (quick, up to 10^5)",
            "type": "shell",
            "command": "python run_tests.py --quick",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "run tests (full, up to 10^6)",
            "type": "shell",
            "command": "python run_tests.py",
            "group": "test",
            "problemMatcher": ["$gcc"]
        }
    ]
}
